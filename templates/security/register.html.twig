{% extends 'base.html.twig' %}
{% block body %}
<div class="row justify-content-center">
<div class="col-md-5">
<h2>Register</h2>
{{ form_start(form, {attr: {class: 'mb-3'}}) }}
    {{ form_row(form.username) }}
    {{ form_row(form.email) }}
    {{ form_row(form.password) }}
    {{ form_row(form.companyName, {label: 'Company Name'}) }}
    {{ form_row(form.faction, {label: 'Starting Faction (IlClan MUL)'}) }}
    <div class="d-flex gap-2">
        <button class="btn btn-primary w-100">Register</button>
    </div>
{{ form_end(form) }}
<p class="mt-2"><a href="{{ path('app_login') }}">Already have an account?</a></p>
</div>
</div>
{% endblock %}
