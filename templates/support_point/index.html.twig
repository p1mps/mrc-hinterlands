{% extends 'base.html.twig' %}
{% block body %}
<h2>Support Points</h2>
<div class="alert alert-info fs-4">Balance: <strong>{{ balance }} SP</strong></div>
<div class="row">
<div class="col-12 col-md-4 mb-4 mb-md-0">
<h5>Add Entry</h5>
{{ form_start(form) }}
{{ form_row(form.amount) }}
{{ form_row(form.description) }}
<button class="btn btn-primary">Add</button>
{{ form_end(form) }}
</div>
<div class="col-12 col-md-8">
<div class="table-responsive">
<table class="table table-sm align-middle">
<thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Running Total</th><th></th></tr></thead>
<tbody>
{% set running = 0 %}
{% for entry in entries %}
{% set running = running + entry.amount %}
<tr class="{{ entry.amount > 0 ? 'table-success' : 'table-danger' }}">
    <td class="text-nowrap">{{ entry.createdAt|date('Y-m-d H:i') }}</td>
    <td>
        {{ entry.description }}
        {% if entry.contractLogEntry is not null %}
            <br><a href="{{ path('app_contracts_show', {id: entry.contractLogEntry.contract.id}) }}" class="badge bg-secondary text-decoration-none">
                Contract: {{ entry.contractLogEntry.contract.name }} (Month {{ entry.contractLogEntry.month }})
            </a>
        {% endif %}
    </td>
    <td>{{ entry.amount > 0 ? '+' : '' }}{{ entry.amount }}</td>
    <td>{{ running }}</td>
    <td>
        <form method="post" action="{{ path('app_support_points_delete', {id: entry.id}) }}"
              onsubmit="return confirm('Delete this entry?')">
            <button class="btn btn-sm btn-danger">Del</button>
        </form>
    </td>
</tr>
{% else %}
<tr><td colspan="5" class="text-muted">No entries yet.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
</div>
</div>
{% endblock %}
