<form method="post" action="{{ path('app_dropship_delete', {'id': dropship.id}) }}" onsubmit="return confirm('Are you sure you want to delete this dropship? All mechs will be unassigned.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dropship.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>
