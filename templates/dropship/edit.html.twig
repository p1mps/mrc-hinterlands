{% extends 'base.html.twig' %}
{% block title %}Edit Dropship{% endblock %}
{% block body %}
    <h2>Edit Dropship</h2>

    <a href="{{ path('app_dropship_show') }}" class="btn btn-outline-secondary mb-3">Back to Dropship</a>

    {{ form_start(form, {attr: {class: 'row g-3'}}) }}

    <div class="col-md-6">{{ form_row(form.name) }}</div>
    <div class="col-md-6">{{ form_row(form.maxCapacity) }}</div>

    <div class="col-12 mt-3">
        <button class="btn btn-primary">Save Changes</button>
    </div>

    {{ form_end(form) }}
{% endblock %}
