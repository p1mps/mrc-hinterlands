{% extends 'base.html.twig' %}
{% block title %}Edit Dropship{% endblock %}
{% block body %}
<div class="row justify-content-center">
<div class="col-md-6">
<h2>Edit Dropship</h2>
<a href="{{ path('app_dropship_show') }}" class="btn btn-outline-secondary mb-3">Back to Dropship</a>
{{ form_start(form, {attr: {class: 'mb-3'}}) }}
    {{ form_row(form.name) }}
    {{ form_row(form.maxCapacity) }}
    {{ form_row(form.mekbayCapacity) }}
    <div class="d-flex gap-2">
        <button class="btn btn-primary">Save Changes</button>
    </div>
{{ form_end(form) }}
</div>
</div>
{% endblock %}
