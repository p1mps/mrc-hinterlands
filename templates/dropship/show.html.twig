{% extends 'base.html.twig' %}
{% block body %}
{% if dropship %}
<div class="row mb-4">
<div class="col-12 col-md-8 col-lg-6">
<div class="table-responsive">
<table class="table table-bordered table-sm">
<tr><th>Name</th><td>{{ dropship.name ?? '—' }}</td></tr>
<tr><th>Max Capacity</th><td>{{ dropship.maxCapacity }}</td></tr>
<tr><th>Mechs On Board</th><td>{{ dropship.salvagedMechs|length }}</td></tr>
</table>
</div>
</div>
</div>

{% set mechCount = dropship.salvagedMechs|length %}
{% if mechCount > 0 %}
<h3 class="mt-3">Mechs on Dropship</h3>
<div class="table-responsive mb-3">
<table class="table table-bordered table-sm">
<thead><tr><th>Model</th><th>Tonnage</th><th>Damaged?</th><th>Acquired?</th></tr></thead>
<tbody>
{% for mech in dropship.salvagedMechs %}
<tr>
    <td>{{ mech.model ?? '—' }}</td>
    <td>{{ mech.tonnage ?? '—' }}</td>
    <td>{{ mech.damageState ? mech.damageState.value : 'No' }}</td>
    <td>{{ mech.isAcquired ? 'Yes' : 'No' }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endif %}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <div class="d-flex gap-2">
        <a href="{{ path('app_dropship_edit', {id: dropship.id}) }}" class="btn btn-primary">Edit Capacity</a>
        {% if mechCount == 0 %}
        <form method="post" action="{{ path('app_dropship_delete', {'id': dropship.id}) }}" onsubmit="return confirm('Are you sure you want to delete this dropship? All mechs will be unassigned.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dropship.id) }}">
            <button class="btn btn-danger">Delete Dropship</button>
        </form>
        {% endif %}
    </div>
</div>

{{ include('dropship/_delete_form.html.twig') }}
{% else %}
<div class="text-center mb-4">
    <p class="lead">No dropship found for your company.</p>
    <a href="{{ path('app_dropship_new') }}" class="btn btn-primary">Create Dropship</a>
</div>
{% endif %}
{% endblock %}
