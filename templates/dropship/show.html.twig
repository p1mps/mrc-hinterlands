{% extends 'base.html.twig' %}
{% block body %}
{% if dropship %}
<div class="row mb-4">
<div class="col-12 col-md-8 col-lg-6">
<div class="table-responsive">
<table class="table table-bordered table-sm">
<tr><th>Name</th><td>{{ dropship.name ?? '—' }}</td></tr>
<tr><th>Max Capacity</th><td>{{ dropship.maxCapacity }} tons</td></tr>
<tr><th>Mekbays</th><td>{{ dropshipService.getUsedMekbays(dropship) }} / {{ dropship.mekbayCapacity }}</td></tr>
<tr><th>Mechs On Board</th><td>{{ dropshipService.getTonnageOnDropship(dropship) }} / {{ dropship.maxCapacity }} tons</td></tr>
</table>
</div>
</div>
</div>

{% set currentTonnage = dropshipService.getTonnageOnDropship(dropship) %}
{% set remainingCapacity = dropship.maxCapacity - currentTonnage %}
{% set usedMekbays = dropshipService.getUsedMekbays(dropship) %}
{% set remainingMekbays = dropship.mekbayCapacity - usedMekbays %}
{% if (dropship.salvagedMechs|length + dropship.unitsOnDropship|length) > 0 %}
<h3 class="mt-3">Mechs on Dropship ({{ currentTonnage }} / {{ dropship.maxCapacity }} tons)</h3>
<div class="table-responsive mb-3">
<table class="table table-bordered table-sm">
<thead><tr><th>Type</th><th>Name / Model</th><th>Tonnage</th><th>Damaged?</th><th>Actions</th></tr></thead>
<tbody>
{% for unit in dropship.unitsOnDropship %}
<tr>
    <td><span class="badge bg-info">Roster</span></td>
    <td>{{ unit.name }}</td>
    <td>{{ unit.tonnage }}</td>
    <td>{{ unit.damageState.value }}</td>
    <td>
        <form method="post" action="{{ path('app_dropship_unassign_unit', {id: dropship.id, unitId: unit.id}) }}" onsubmit="return confirm('Remove {{ unit.name }} from dropship?');">
            <input type="hidden" name="_token" value="csrf_unassign_unit_{{ unit.id }}">
            <button class="btn btn-sm btn-outline-danger">Unassign</button>
        </form>
    </td>
</tr>
{% endfor %}
{% for mech in dropship.salvagedMechs %}
<tr>
    <td><span class="badge bg-secondary">Salvage</span></td>
    <td>{{ mech.model ?? '—' }}</td>
    <td>{{ mech.tonnage }}</td>
    <td>{{ mech.damageState ? mech.damageState.value : 'No' }}</td>
    <td>
        <form method="post" action="{{ path('app_dropship_unassign_mech', {id: dropship.id, mechanId: mech.id}) }}" onsubmit="return confirm('Remove {{ mech.model }} from dropship?');">
            <input type="hidden" name="_token" value="csrf_unassign_mech_{{ mech.id }}">
            <button class="btn btn-sm btn-outline-danger">Unassign</button>
        </form>
    </td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endif %}

{% if remainingCapacity > 0 %}
{% set unassignedUnits = dropship.company.units|filter(u => u.dropship is null) %}
{% set unassignedSalvaged = dropshipService.getUnassignedMechs(dropship.company) %}
{% if (unassignedUnits|length + unassignedSalvaged|length) > 0 %}
<h4 class="mt-3">Available to Board ({{ remainingCapacity }} tons left{% if remainingMekbays > 0 %}, {{ remainingMekbays }} mekbays left{% endif %})</h4>
<div class="table-responsive mb-3">
<table class="table table-bordered table-sm">
<thead><tr><th>Type</th><th>Name / Model</th><th>Tonnage</th><th>Actions</th></tr></thead>
<tbody>
{% for unit in unassignedUnits %}
<tr>
    <td><span class="badge bg-info">Roster</span></td>
    <td>{{ unit.name }}</td>
    <td>{{ unit.tonnage }}</td>
    <td>
        {% if remainingMekbays > 0 %}
        <form method="post" action="{{ path('app_dropship_assign_unit', {unitId: unit.id, id: dropship.id}) }}" onsubmit="return confirm('Board {{ unit.name }} on {{ dropship.name }}? This will take {{ unit.tonnage }} tons of capacity and 1 mekbay.');">
            <input type="hidden" name="_token" value="csrf_board_unit_{{ unit.id }}">
            <button class="btn btn-sm btn-outline-secondary">Board</button>
        </form>
        {% else %}
        <span class="text-muted">No mekbays</span>
        {% endif %}
    </td>
</tr>
{% endfor %}
{% for mech in unassignedSalvaged %}
<tr>
    <td><span class="badge bg-secondary">Salvage</span></td>
    <td>{{ mech.model ?? '—' }}</td>
    <td>{{ mech.tonnage }}</td>
    <td>
        <form method="post" action="{{ path('app_dropship_assign_mech', {mechanId: mech.id, id: dropship.id}) }}" onsubmit="return confirm('Board {{ mech.model }} on {{ dropship.name }}? This will take {{ mech.tonnage }} tons of capacity.');">
            <input type="hidden" name="_token" value="csrf_board_mech_{{ mech.id }}">
            <button class="btn btn-sm btn-outline-secondary">Board</button>
        </form>
    </td>
</tr>
{% endfor %}
</tbody>
</table>
</div>
{% endif %}
{% endif %}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <div class="d-flex gap-2">
        <a href="{{ path('app_dropship_edit', {id: dropship.id}) }}" class="btn btn-primary">Edit Capacity</a>
        {% if currentTonnage == 0 %}
        <form method="post" action="{{ path('app_dropship_delete', {'id': dropship.id}) }}" onsubmit="return confirm('Are you sure you want to delete this dropship? All mechs will be unassigned.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dropship.id) }}">
            <button class="btn btn-danger">Delete Dropship</button>
        </form>
        {% endif %}
    </div>
</div>

{{ include('dropship/_delete_form.html.twig') }}
{% else %}
<div class="text-center mb-4">
    <p class="lead">No dropship found for your company.</p>
    <a href="{{ path('app_dropship_new') }}" class="btn btn-primary">Create Dropship</a>
</div>
{% endif %}
{% endblock %}
