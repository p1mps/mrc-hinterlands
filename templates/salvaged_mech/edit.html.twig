{% extends 'base.html.twig' %}

{% block title %}Edit Salvaged Mech{% endblock %}

{% block body %}
    <h1>Edit Salvaged Mech</h1>

    {{ include('salvaged_mech/_form.html.twig', {'button_label': 'Update'}) }}

    {% if not salvaged_mech.isAcquired %}
        <div class="mt-4">
            <form method="post" action="{{ path('app_salvaged_mech_acquire', {id: salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to acquire this mech? This will deduct BV cost from your support points.');">
                <input type="hidden" name="_token" value="{{ csrf_token('acquire' ~ salvaged_mech.id) }}">
                <button class="btn btn-success">Acquire Mech</button>
            </form>
        </div>
    {% endif %}

    <a href="{{ path('app_salvaged_mech_index') }}">back to list</a>

    {{ include('salvaged_mech/_delete_form.html.twig') }}
{% endblock %}
