{% extends 'base.html.twig' %}

{% block title %}Edit Salvaged Mech{% endblock %}

{% block body %}
    <h2>Edit Salvaged Mech — {{ salvaged_mech.name }}</h2>
    
    <a href="{{ path('app_salvaged_mech_show', {id: salvaged_mech.id}) }}" class="btn btn-outline-secondary mb-3">Back to Details</a>

    {{ form_start(form, {attr: {class: 'row g-3'}}) }}
        <div class="col-md-6">{{ form_row(form.name) }}</div>
        <div class="col-md-6">{{ form_row(form.model) }}</div>
        <div class="col-md-4">{{ form_row(form.tonnage) }}</div>
        <div class="col-md-4">{{ form_row(form.bvCost) }}</div>
        <div class="col-md-12">{{ form_row(form.configuration) }}</div>
        
        <div class="col-12">
            <button class="btn btn-primary">Save Changes</button>
        </div>
    {{ form_end(form) }}

    {% if not salvaged_mech.isAcquired %}
        <div class="mt-4 pt-3 border-top">
            <h5>Acquisition</h5>
            <p class="text-muted">Acquiring this mech will deduct its BV cost from your company's support points and add it to your roster.</p>
            <form method="post" action="{{ path('app_salvaged_mech_acquire', {id: salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to acquire this mech? This will deduct BV cost from your support points.');">
                <input type="hidden" name="_token" value="{{ csrf_token('acquire' ~ salvaged_mech.id) }}">
                <button class="btn btn-success">Acquire Mech</button>
            </form>
        </div>
    {% endif %}

    {{ include('salvaged_mech/_delete_form.html.twig') }}
{% endblock %}
