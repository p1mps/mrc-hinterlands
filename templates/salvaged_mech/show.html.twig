{% extends 'base.html.twig' %}

{% block title %}Salvaged Mech{% endblock %}

{% block body %}
    <h1>Salvaged Mech</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Name</th>
                <td>{{ salvaged_mech.name }}</td>
            </tr>
            <tr>
                <th>Model</th>
                <td>{{ salvaged_mech.model }}</td>
            </tr>
            <tr>
                <th>Tonnage</th>
                <td>{{ salvaged_mech.tonnage }}</td>
            </tr>
            <tr>
                <th>Configuration</th>
                <td>{{ salvaged_mech.configuration }}</td>
            </tr>
            <tr>
                <th>Source Log Entry</th>
                <td>{{ salvaged_mech.sourceLogEntry.description ?? 'N/A' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_salvaged_mech_index') }}">back to list</a>
    <a href="{{ path('app_salvaged_mech_edit', {'id': salvaged_mech.id}) }}">Edit</a>

    {{ include('salvaged_mech/_delete_form.html.twig') }}
{% endblock %}
