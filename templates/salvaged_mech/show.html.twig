{% extends 'base.html.twig' %}

{% block title %}Salvaged Mech{% endblock %}

{% block body %}
    <h2>{{ salvaged_mech.name }}</h2>
    
    <div class="row mb-4">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <tr><th>Name</th><td>{{ salvaged_mech.name }}</td></tr>
                    <tr><th>Model</th><td>{{ salvaged_mech.model ?? '—' }}</td></tr>
                    <tr><th>Tonnage</th><td>{{ salvaged_mech.tonnage ?? '—' }}</td></tr>
                    <tr><th>BV Cost</th><td>{{ salvaged_mech.bvCost ?? '—' }}</td></tr>
                    <tr><th>Configuration</th><td>{{ salvaged_mech.configuration ?? '—' }}</td></tr>
                    <tr><th>Source Log Entry</th><td>{{ salvaged_mech.sourceLogEntry.description ?? 'N/A' }}</td></tr>
                    <tr><th>Salvaged At</th><td>{{ salvaged_mech.salvagedAt|date('Y-m-d H:i') }}</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ path('app_salvaged_mech_index') }}" class="btn btn-outline-secondary">Back to list</a>
        <a href="{{ path('app_salvaged_mech_edit', {'id': salvaged_mech.id}) }}" class="btn btn-primary">Edit</a>
        
        {% if not salvaged_mech.isAcquired %}
            <form method="post" action="{{ path('app_salvaged_mech_acquire', {id: salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to acquire this mech? This will deduct BV cost from your support points.');" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('acquire' ~ salvaged_mech.id) }}">
                <button class="btn btn-success">Acquire Mech</button>
            </form>
        {% endif %}
    </div>

    {{ include('salvaged_mech/_delete_form.html.twig') }}
{% endblock %}
