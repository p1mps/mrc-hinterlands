{% extends 'base.html.twig' %}

{% block title %}Salvaged Mechs{% endblock %}

{% block body %}
    <h1>Salvaged Mechs</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Model</th>
                <th>Tonnage</th>
                <th>Source</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for salvaged_mech in salvaged_mechs %}
            <tr>
                <td>{{ salvaged_mech.name }}</td>
                <td>{{ salvaged_mech.model }}</td>
                <td>{{ salvaged_mech.tonnage }}</td>
                <td>{{ salvaged_mech.sourceLogEntry.description ?? 'N/A' }}</td>
                <td>
                    <a href="{{ path('app_salvaged_mech_show', {'id': salvaged_mech.id}) }}">Show</a>
                    <a href="{{ path('app_salvaged_mech_edit', {'id': salvaged_mech.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_salvaged_mech_new') }}">Create new</a>
{% endblock %}
