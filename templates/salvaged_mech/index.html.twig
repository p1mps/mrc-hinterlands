{% extends 'base.html.twig' %}

{% block title %}Salvaged Mechs{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h2>Salvaged Mechs</h2>
    <div class="d-flex gap-2">
        <a href="{{ path('app_salvaged_mech_new') }}" class="btn btn-primary">Scrapyard</a>
        <a href="{{ path('app_salvaged_mech_new_with_check') }}" class="btn btn-success">Battlefield Salvage</a>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Model</th>
            <th>Tonnage</th>
            <th>BV</th>
            <th>Base Price</th>
            <th>Salvage Rights %</th>
            <th>Acquisition Cost</th>
            <th>Sell Value</th>
            <th>Damage State</th>
            <th>Tech Base</th>
            <th>Source</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for salvaged_mech in salvaged_mechs %}
    <tr>
        <td>{{ salvaged_mech.model }}</td>
        <td>{{ salvaged_mech.tonnage }}</td>
        <td>{{ salvaged_mech.bvCost }}</td>
        <td>{{ basePrices[salvaged_mech.id] ?? '-' }}</td>
        <td>
            {% set srPct = salvageRightsPcts[salvaged_mech.id] %}
            {% if salvaged_mech.isScrapyard %}
                <span class="text-muted">N/A (scrapyard)</span>
            {% else %}
                {{ srPct }}%
            {% endif %}
        </td>
        <td>{{ acquisitionCosts[salvaged_mech.id] ?? '-' }}</td>
        <td>{{ sellValues[salvaged_mech.id] ?? '-' }}</td>
        <td>{{ salvaged_mech.damageState ? salvaged_mech.damageState.value : '—' }}</td>
        <td>{{ salvaged_mech.techBase ? salvaged_mech.techBase.value : '—' }}</td>
        <td>{{ salvaged_mech.scrapyard ? 'Scrapyard' : 'Battlefield' }}</td>
        <td>
            <span class="badge bg-info">Available</span>
        </td>
        <td class="text-nowrap">
            {% set dropship = dropshipService.getDropshipByCompany(company) %}
            <a href="{{ path('app_salvaged_mech_edit', {'id': salvaged_mech.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form method="post" action="{{ path('app_salvaged_mech_acquire', {id: salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to acquire this mech? This will cost {{ acquisitionCosts[salvaged_mech.id] }} support points.');" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('acquire' ~ salvaged_mech.id) }}">
                    <button class="btn btn-sm btn-success">Acquire Mech</button>
                </form>
                <form method="post" action="{{ path('app_salvaged_mech_sell', {id: salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to sell this mech?');" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('sell' ~ salvaged_mech.id) }}">
                    <button class="btn btn-sm btn-warning">Sell</button>
                </form>
            <form method="post" action="{{ path('app_salvaged_mech_delete', {'id': salvaged_mech.id}) }}" onsubmit="return confirm('Are you sure you want to delete this mech?');" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ salvaged_mech.id) }}">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </td>
    </tr>
    {% else %}
    <tr><td colspan="12" class="text-muted">No records found.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
