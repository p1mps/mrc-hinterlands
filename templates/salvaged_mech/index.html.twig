{% extends 'base.html.twig' %}

{% block title %}Salvaged Mechs{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h2>Salvaged Mechs</h2>
    <a href="{{ path('app_salvaged_mech_new') }}" class="btn btn-primary align-self-start align-self-sm-auto">Create new</a>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Model</th>
            <th>Tonnage</th>
            <th>BV Cost</th>
            <th>Source</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for salvaged_mech in salvaged_mechs %}
    <tr>
        <td>{{ salvaged_mech.name }}</td>
        <td>{{ salvaged_mech.model ?? '—' }}</td>
        <td>{{ salvaged_mech.tonnage ?? '—' }}</td>
        <td>{{ salvaged_mech.bvCost ?? '—' }}</td>
        <td>{{ salvaged_mech.sourceLogEntry.description ?? 'N/A' }}</td>
        <td class="text-nowrap">
            <a href="{{ path('app_salvaged_mech_show', {'id': salvaged_mech.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
            <a href="{{ path('app_salvaged_mech_edit', {'id': salvaged_mech.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
        </td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="text-muted">No records found.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
