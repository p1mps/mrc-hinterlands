{% extends 'base.html.twig' %}
{% block body %}
    <h2>Edit Scrapyard Mech — {{ salvaged_mech.model }}</h2>
    <a href="{{ path('app_salvaged_mech_show', {id: salvaged_mech.id}) }}" class="btn btn-outline-secondary mb-3">Back to Details</a>

    {{ form_start(form, {attr: {class: 'row g-3'}}) }}

    <div class="col-md-6">{{ form_row(form.model) }}</div>
    <div class="col-md-6">{{ form_row(form.tonnage) }}</div>
    <div class="col-md-6">{{ form_row(form.bvCost) }}</div>
    <div class="col-md-6">{{ form_row(form.damageState) }}</div>
    <div class="col-md-6">{{ form_row(form.techBase) }}</div>

    <div class="col-12">
        <button class="btn btn-primary">Save Changes</button>
    </div>

    {{ form_end(form) }}
{% endblock %}
