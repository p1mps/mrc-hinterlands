{% extends 'base.html.twig' %}

{% block title %}New Salvaged Mech{% endblock %}

{% block body %}
    <h2>Create new Salvaged Mech</h2>
    
    <a href="{{ path('app_salvaged_mech_index') }}" class="btn btn-outline-secondary mb-3">Back to list</a>

    {{ form_start(form, {attr: {class: 'row g-3'}}) }}
        <div class="col-md-6">{{ form_row(form.name) }}</div>
        <div class="col-md-6">{{ form_row(form.model) }}</div>
        <div class="col-md-4">{{ form_row(form.tonnage) }}</div>
        <div class="col-md-4">{{ form_row(form.bvCost) }}</div>
        <div class="col-md-12">{{ form_row(form.configuration) }}</div>
        
        <div class="col-12">
            <button class="btn btn-primary">Save</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
