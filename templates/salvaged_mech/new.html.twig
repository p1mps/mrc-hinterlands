{% extends 'base.html.twig' %}

{% block title %}New Salvaged Mech{% endblock %}

{% block body %}
    <h2>Create new Salvaged Mech</h2>

    <a href="{{ path('app_salvaged_mech_index') }}" class="btn btn-outline-secondary mb-3">Back to list</a>

    {{ form_start(form) }}
        {{ form_row(form.model) }}
        {{ form_row(form.tonnage) }}
        {{ form_row(form.bvCost) }}

        <div class="col-12">
            <button class="btn btn-primary">Save</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
