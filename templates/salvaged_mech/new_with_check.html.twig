{% extends 'base.html.twig' %}

{% block title %}New Battlefield Salvaged {% endblock %}

{% block body %}
    <h2>New Battlefield Salvaged Mech</h2>

    <a href="{{ path('app_salvaged_mech_index') }}" class="btn btn-outline-secondary mb-3">Back to list</a>

    {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.model) }}</div>
            <div class="col-md-6">{{ form_row(form.tonnage) }}</div>
            <div class="col-md-6">{{ form_row(form.bvCost) }}</div>
            <div class="col-md-6">{{ form_row(form.damageState) }}</div>
            <div class="col-md-6">{{ form_row(form.techBase) }}</div>
        </div>

        <div class="col-12 mt-3">
            <button class="btn btn-success">Save</button>
        </div>
    {{ form_end(form) }}
{% endblock %}
