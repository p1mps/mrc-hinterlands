{% extends 'base.html.twig' %}
{% block body %}
<h2>Contract Offer</h2>

{% if company %}
<div class="alert alert-info d-flex justify-content-between align-items-center">
    <span>Company Reputation: <strong>{{ company.reputation }}</strong> (Scale {{ company.scaleFromReputation }})</span>
    <div>
        <a href="{{ path('app_contracts_generate', {scale: scale}) }}" class="btn btn-sm btn-outline-secondary me-2">Standard Offer</a>
        <a href="{{ path('app_contracts_generate', {scale: scale, negotiate: true}) }}" class="btn btn-sm btn-outline-info">Negotiate Offer</a>
    </div>
</div>
{% endif %}

<!-- Negotiation UI (only shown when negotiate=1) -->
{% if data.negotiationSummary is defined %}
<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Contract Negotiation</h5>
    </div>
    <div class="card-body">
        <p>
            Reputation: <strong>{{ data.negotiationSummary.reputation }}</strong> |
            Available shifts: <strong id="negotiation-budget"><strong>{{ data.negotiationSummary.availableSteps }}</strong></strong>
        </p>
        <p class="text-muted small">
            Each point of reputation lets you shift one category up by 1 step (max {{ 2 * (data.scale ?? scale) }} for your scale).
        </p>
    </div>
</div>

<form id="negotiate-form" method="post" action="{{ path('app_contracts_negotiate') }}">
    <input type="hidden" name="scale" value="{{ data.scale ?? scale }}">

    <div class="table-responsive mb-3">
        <table class="table table-sm table-bordered" id="negotiation-table">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Base Step</th>
                    <th>Current Step</th>
                    <th>Current Value</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% set categories = [
                { key: 'basePayPercent', label: 'Pay Rate' },
                { key: 'commandRights', label: 'Command Rights' },
                { key: 'salvageRights', label: 'Salvage Rights' },
                { key: 'supportTerms', label: 'Support' },
                { key: 'transportTerms', label: 'Transportation' }
            ] %}

            {% for cat in categories %}
                {% set baseStep = 1 %}
                {% for r in data.rolls %}
                    {% if r.label == cat.label and r.step is defined %}
                        {% set baseStep = r.step %}
                    {% endif %}
                {% endfor %}
                <tr data-key="{{ cat.key }}">
                    <td>{{ cat.label }}</td>
                    <td class="base-step">{{ baseStep }}</td>
                    <td>
                        <span class="current-step">{{ baseStep }}</span>
                    </td>
                    <td>
                        <span class="current-value"></span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-sm btn-outline-primary shift-up"
                                    data-key="{{ cat.key }}" data-base="{{ baseStep }}">
                                +1 Step
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary shift-down"
                                    data-key="{{ cat.key }}" data-base="{{ baseStep }}"
                                    disabled>
                                -1 Step
                            </button>
                        </div>
                    </td>
                </tr>
            {% endfor %}

            {% set tracksBase = 2 %}
            {% for r in data.rolls %}
                {% if r.label == 'Number of Tracks' and r.result is defined %}
                    {% set tracksBase = r.result %}
                {% endif %}
            {% endfor %}
            <tr data-key="numberOfTracks">
                <td>Number of Tracks</td>
                <td class="base-step">{{ tracksBase }}</td>
                <td>
                    <span class="current-step">{{ tracksBase }}</span>
                </td>
                <td>
                    <span class="current-value"></span>
                </td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-sm btn-outline-primary shift-up"
                                data-key="numberOfTracks" data-base="{{ tracksBase }}"
                                data-min="1" data-max="5">
                            +1 Track
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary shift-down"
                                data-key="numberOfTracks" data-base="{{ tracksBase }}"
                                data-min="1" data-max="5"
                                disabled>
                            -1 Track
                        </button>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </div>

    <button class="btn btn-success">Accept Contract</button>
</form>
{% endif %}

<div class="d-flex gap-4 align-items-start flex-wrap">
    <table class="table table-bordered w-auto flex-shrink-0">
        <tr><th>Type</th><td>{{ data.type.value }}</td></tr>
        <tr><th>Duration</th><td>{{ data.duration }} months</td></tr>
        <tr><th>Employer</th><td>{{ data.employer }}</td></tr>
        <tr><th>Affiliation</th><td>{{ data.affiliation }}</td></tr>
        <tr><th>Base Pay</th><td data-term="basePayPercent">{{ data.basePayPercent is not null ? data.basePayPercent ~ '%' : 'None' }}</td></tr>
        <tr><th>Command Rights</th><td data-term="commandRights">{{ data.commandRights.value }}</td></tr>
        <tr><th>Support Terms</th><td data-term="supportTerms">{{ data.supportTerms }}</td></tr>
        <tr><th>Salvage Rights</th><td data-term="salvageRights">{{ data.salvageRights }}</td></tr>
        <tr><th>Transport Terms</th><td data-term="transportTerms">{{ data.transportTerms }}</td></tr>
        <tr><th>Number of Tracks</th><td>{{ data.numberOfTracks }}</td></tr>
    </table>

    <div>
        <h5>Roll Breakdown</h5>
        <table class="table table-sm table-striped w-auto">
            <thead><tr><th>Step</th><th>Roll</th><th>Modifier</th><th>Step/Result</th></tr></thead>
            <tbody>
            {% for r in data.rolls %}
                <tr>
                    <td>{{ r.label }}</td>
                    <td>{{ r.roll }}</td>
                    <td>{{ r.modifier is defined ? (r.modifier >= 0 ? '+' : '') ~ r.modifier : '—' }}</td>
                    <td>{{ r.step is defined ? r.step : (r.result is defined ? r.result : '—') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if data.negotiationSummary is defined %}
<div class="mt-3 p-3 border rounded">
    <h5>Negotiation Summary</h5>
    <p>Reputation: {{ data.negotiationSummary.reputation }} | Available shifts: {{ data.negotiationSummary.availableSteps }}</p>
</div>
{% endif %}

{% if data.negotiationSummary is not defined %}
<form method="post" action="{{ path('app_contracts_accept') }}" class="d-inline">
    <input type="hidden" name="type"           value="{{ data.type.value }}">
    <input type="hidden" name="duration"       value="{{ data.duration }}">
    <input type="hidden" name="employer"       value="{{ data.employer }}">
    <input type="hidden" name="affiliation"    value="{{ data.affiliation }}">
    <input type="hidden" name="scale"          value="{{ data.scale ?? scale }}">
    <input type="hidden" name="basePayPercent" value="{{ data.basePayPercent ?? '' }}">
    <input type="hidden" name="commandRights"  value="{{ data.commandRights.value }}">
    <input type="hidden" name="supportTerms"   value="{{ data.supportTerms }}">
    <input type="hidden" name="salvageRights"  value="{{ data.salvageRights }}">
    <input type="hidden" name="transportTerms" value="{{ data.transportTerms }}">
    <input type="hidden" name="numberOfTracks" value="{{ data.numberOfTracks }}">
    <button class="btn btn-success">Accept Contract</button>
</form>
<form method="post" action="{{ path('app_contracts_discard') }}" class="d-inline ms-2">
    <button class="btn btn-secondary" onclick="return confirm('Discard this contract?')">Discard</button>
</form>
{% endif %}

{% if data.negotiationSummary is defined %}
<script>
(function() {
    const MAX_STEP = 13;
    const baseReputation = {{ data.negotiationSummary.reputation }};
    const maxShifts = {{ data.negotiationSummary.availableSteps }};

    // 13-step contract steps table for JS lookup
    const STEPS_TABLE = {{ data.steptsTable|raw }};

    // State
    let availableShifts = maxShifts;
    // Map of key -> current step (starts at base step)
    const state = {};

    // Initialize state from the DOM (base steps)
    const rows = document.querySelectorAll('#negotiation-table tbody tr');
    rows.forEach(row => {
        const key = row.dataset.key;
        const baseStep = parseInt(row.querySelector('.base-step').textContent);
        state[key] = baseStep;
        const valueSpan = row.querySelector('.current-value');
        valueSpan.textContent = formatValue(key, baseStep);
    });

    const budgetEl = document.getElementById('negotiation-budget');
    const form = document.getElementById('negotiate-form');

    // Find next valid step >= current (for shift-up when already on valid step, find next ABOVE)
    function getNextValidStepUp(currentStep, category) {
        // Special case: Number of Tracks is 1-5, not on 13-step table
        if (category === 'numberOfTracks') {
            return Math.min(5, currentStep + 1);
        }
        for (let i = currentStep + 1; i <= 13; i++) {
            const values = STEPS_TABLE[i];
            if (!values) continue;
            const isValid = category === 'basePayPercent' || category === 'supportTerms'
                || values[1] !== null || values[2] !== null || values[4] !== null;
            if (isValid) {
                // Check the specific category's value
                const catValue = values[category];
                if (category === 'basePayPercent' || category === 'supportTerms') return i;
                if (category === 'commandRights' && values[1] !== null) return i;
                if (category === 'salvageRights' && values[2] !== null) return i;
                if (category === 'transportTerms' && values[4] !== null) return i;
            }
        }
        return null;
    }

    // Find previous valid step <= current (for shift-down when already on valid step, find prev BELOW)
    function getPrevValidStepDown(currentStep, category) {
        // Special case: Number of Tracks is 1-5, not on 13-step table
        if (category === 'numberOfTracks') {
            return Math.max(1, currentStep - 1);
        }
        for (let i = currentStep - 1; i >= 1; i--) {
            const values = STEPS_TABLE[i];
            if (!values) continue;
            const catValue = values[category];
            if (category === 'basePayPercent' || category === 'supportTerms') return i;
            if (category === 'commandRights' && values[1] !== null) return i;
            if (category === 'salvageRights' && values[2] !== null) return i;
            if (category === 'transportTerms' && values[4] !== null) return i;
        }
        return null;
    }

    function updateUI() {
        budgetEl.textContent = availableShifts;

        // Update all shift buttons
        document.querySelectorAll('.shift-up').forEach(btn => {
            const key = btn.dataset.key;
            const baseStep = parseInt(btn.dataset.base);
            const currentStep = state[key];

            const nextValid = getNextValidStepUp(currentStep, key);
            if (nextValid === null) {
                btn.disabled = true;
                btn.textContent = 'Max';
            } else {
                const cost = nextValid - currentStep;
                if (cost > availableShifts) {
                    btn.disabled = true;
                    btn.textContent = 'No budget';
                } else {
                    btn.disabled = false;
                    const label = key === 'numberOfTracks' ? '+1 Track' : '+1 Step';
                    btn.textContent = cost > 1 ? label + ' (' + cost + ' pts)' : label;
                }
            }

            const stepSpan = btn.closest('tr').querySelector('.current-step');
            stepSpan.textContent = currentStep;

            const valueSpan = btn.closest('tr').querySelector('.current-value');
            valueSpan.textContent = formatValue(key, currentStep);
        });

        // Update all shift-down buttons
        document.querySelectorAll('.shift-down').forEach(btn => {
            const key = btn.dataset.key;
            const baseStep = parseInt(btn.dataset.base);
            const currentStep = state[key];

            const prevValid = getPrevValidStepDown(currentStep, key);
            const minTrack = parseInt(btn.dataset.min || 1);
            if (prevValid === null || prevValid < minTrack || prevValid >= baseStep) {
                btn.disabled = true;
                btn.textContent = key === 'numberOfTracks' ? '-1 Track' : '-1 Step';
            } else {
                const refund = currentStep - prevValid;
                btn.disabled = false;
                const label = key === 'numberOfTracks' ? '-1 Track' : '-1 Step';
                btn.textContent = refund > 1 ? label + ' (' + refund + ' pts)' : label;
            }

            const valueSpan = btn.closest('tr').querySelector('.current-value');
            valueSpan.textContent = formatValue(key, currentStep);
        });

        // Refresh contract terms display
        refreshContractTerms();
    }

    function refreshContractTerms() {
        const categoryMap = {
            basePayPercent: 'basePayPercent',
            commandRights: 'commandRights',
            salvageRights: 'salvageRights',
            supportTerms: 'supportTerms',
            transportTerms: 'transportTerms',
        };

        for (const [key, fieldName] of Object.entries(categoryMap)) {
            const step = state[key];
            if (!step) continue;
            const cell = document.querySelector(`td[data-term="${fieldName}"]`);
            if (!cell) continue;
            const stepData = STEPS_TABLE[step];
            if (!stepData) continue;
            const value = stepData[fieldName];
            if (value === null || value === undefined) {
                cell.textContent = 'None';
            } else if (fieldName === 'basePayPercent') {
                cell.textContent = value + '%';
            } else {
                cell.textContent = value;
            }
        }
    }

    function formatValue(key, step) {
        if (key === 'numberOfTracks') {
            return step.toString();
        }
        const stepData = STEPS_TABLE[step];
        if (!stepData) return '';
        const value = stepData[key];
        if (value === null || value === undefined) return '—';
        if (key === 'basePayPercent') return value + '%';
        return value;
    }

    // Shift a category up by 1 valid step (costs reputation points for blank steps)
    document.querySelectorAll('.shift-up').forEach(btn => {
        btn.addEventListener('click', function() {
            const key = this.dataset.key;
            const currentStep = state[key];

            const nextValid = getNextValidStepUp(currentStep, key);
            if (nextValid === null) return;

            const cost = nextValid - currentStep;
            if (cost > availableShifts) return;

            state[key] = nextValid;
            availableShifts -= cost;
            updateUI();
        });
    });

    // Shift a category down by 1 valid step (returns reputation points for blank steps)
    document.querySelectorAll('.shift-down').forEach(btn => {
        btn.addEventListener('click', function() {
            const key = this.dataset.key;
            const baseStep = parseInt(this.dataset.base);
            const currentStep = state[key];

            const prevValid = getPrevValidStepDown(currentStep, key);
            if (prevValid === null || prevValid >= baseStep) return;

            const refund = currentStep - prevValid;
            state[key] = prevValid;
            availableShifts += refund;
            updateUI();
        });
    });

    // On form submit, build hidden fields for server-side validation
    form.addEventListener('submit', function(e) {
        // Build base steps from the DOM
        const baseSteps = {};
        document.querySelectorAll('#negotiation-table tbody tr').forEach(row => {
            baseSteps[row.dataset.key] = parseInt(row.querySelector('.base-step').textContent);
        });

        let stateField = form.querySelector('input[name="negotiation_state"]');
        if (!stateField) {
            stateField = document.createElement('input');
            stateField.name = 'negotiation_state';
            stateField.type = 'hidden';
            form.appendChild(stateField);
        }
        stateField.value = JSON.stringify(state);

        let baseField = form.querySelector('input[name="base_steps"]');
        if (!baseField) {
            baseField = document.createElement('input');
            baseField.name = 'base_steps';
            baseField.type = 'hidden';
            form.appendChild(baseField);
        }
        baseField.value = JSON.stringify(baseSteps);

        // Send shifts used
        let shiftsUsedField = form.querySelector('input[name="shifts_used"]');
        if (!shiftsUsedField) {
            shiftsUsedField = document.createElement('input');
            shiftsUsedField.name = 'shifts_used';
            shiftsUsedField.type = 'hidden';
            form.appendChild(shiftsUsedField);
        }
        shiftsUsedField.value = maxShifts - availableShifts;
    });

    updateUI();
})();
</script>
{% endif %}
{% endblock %}
