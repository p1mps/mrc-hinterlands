{% extends 'base.html.twig' %}
{% block body %}
<h2>{{ contract.name }}</h2>
<div class="row mb-4">
<div class="col-12 col-md-8 col-lg-6">
<div class="table-responsive">
<table class="table table-bordered table-sm">
<tr><th>Employer</th><td>{{ contract.employer }}</td></tr>
<tr><th>Affiliation</th><td>{{ contract.employerAffiliation }}</td></tr>
<tr><th>Scale</th><td>{{ contract.scale }}</td></tr>
<tr><th>Duration</th><td>{{ contract.durationMonths }} months</td></tr>
<tr><th>Base Pay</th><td>{{ contract.basePayPercent is not null ? contract.basePayPercent ~ '%' : 'None' }}</td></tr>
<tr><th>Command Rights</th><td>{{ contract.commandRights.value }}</td></tr>
<tr><th>Support Terms</th><td>{{ contract.supportTerms }}</td></tr>
<tr><th>Salvage Rights</th><td>{{ contract.salvageRights }}</td></tr>
<tr><th>Transport Terms</th><td>{{ contract.transportTerms }}</td></tr>
<tr><th>Planet</th><td>{{ contract.planet ?? '—' }}</td></tr>
<tr><th>Intensity</th><td>{{ contract.intensity ?? '—' }}</td></tr>
<tr><th>Status</th><td>{{ contract.status.value }}</td></tr>
<tr><th>Tracks</th><td>{{ contract.tracksCompleted }}/{{ contract.numberOfTracks }}</td></tr>
</table>
</div>
</div>
</div>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h4 class="mb-0">Monthly Log</h4>
    <div class="d-flex gap-2">
        <a href="{{ path('app_contracts_edit', {id: contract.id}) }}" class="btn btn-outline-secondary">Edit Contract</a>
        <a href="{{ path('app_contracts_negotiate_view', {id: contract.id}) }}" class="btn btn-outline-info">Negotiate</a>
        {% if contract.status.value == 'accepted' %}
        <a href="{{ path('app_contracts_log_add', {id: contract.id}) }}" class="btn btn-primary">Add Log Entry</a>
        {% endif %}
    </div>
</div>

{% if contract.description %}<div class="contract-description">{{ contract.description|markdown_to_html }}</div>{% endif %}

{% set currentMonth = 0 %}
{% for entry in contract.logEntries %}
    {% if entry.month != currentMonth %}
        {% set currentMonth = entry.month %}
        <h5 class="mt-3">Month {{ currentMonth }}</h5>
    {% endif %}
    <div class="card mb-2">
    <div class="card-body py-2 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
        <div>
            <span class="badge bg-secondary me-2">{{ entry.entryType.value }}</span>
            {{ entry.description }}
            {% if entry.supportPointEntry is not null %}
                <a href="{{ path('app_support_points') }}" class="badge bg-info text-dark text-decoration-none ms-2">
                    SP: {{ entry.supportPointEntry.amount > 0 ? '+' : '' }}{{ entry.supportPointEntry.amount }}
                </a>
            {% endif %}
            {% if entry.rollResult is not null %}<span class="text-muted ms-2">(rolled {{ entry.rollResult }})</span>{% endif %}
            {% if entry.data is not null and entry.data.complication is defined %}
                <div class="text-muted small mt-1">
                    Mission: {{ entry.data.missionType }} &bull; Terrain: {{ entry.data.terrain }}
                    <br><strong>Complication:</strong> {{ entry.data.complication }}
                </div>
            {% endif %}
        </div>
        <div class="d-flex gap-1 align-self-end align-self-sm-center">
            <a href="{{ path('app_contracts_log_edit', {id: contract.id, entryId: entry.id}) }}"
               class="btn btn-sm btn-outline-secondary">Edit</a>
            <form method="post" action="{{ path('app_contracts_log_delete', {id: contract.id, entryId: entry.id}) }}"
                  class="d-inline" onsubmit="return confirm('Delete this log entry?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>
    </div>
{% else %}
<p class="text-muted">No log entries yet.</p>
{% endfor %}

{% if contract.salvagedMechs and contract.salvagedMechs|length > 0 %}
<h4 class="mt-4">Salvaged Mechs for this Contract</h4>
<div class="table-responsive">
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Model</th>
            <th>Salvage Value</th>
            <th>Salvage Rights</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    {% for mech in contract.salvagedMechs %}
    <tr{% if mech.isTrulyDestroyed %} class="table-danger"{% endif %}>
        <td>{{ mech.model }}</td>
        <td>{{ mech.salvageValue ?? '—' }}</td>
        <td>{{ mech.salvageRightsPercent is null ? 'Exchange (25%)' : (mech.salvageRightsPercent ~ '%') }}</td>
        <td>
            {% if mech.isTrulyDestroyed %}
                <span class="badge bg-danger">Truly Destroyed</span>
            {% elseif mech.contractId is not null %}
                <span class="badge bg-success">Acquired</span>
            {% elseif mech.spTaken is not null %}
                <span class="badge bg-warning">SP Taken</span>
            {% else %}
                <span class="badge bg-info">Available</span>
            {% endif %}
        </td>
    </tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endif %}
{% endblock %}
