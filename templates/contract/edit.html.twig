{% extends 'base.html.twig' %}
{% block body %}
    <h2>Edit Contract — {{ contract.type.value|capitalize }}</h2>
    <a href="{{ path('app_contracts_show', {id: contract.id}) }}" class="btn btn-outline-secondary mb-3">Back to Contract</a>

    {{ form_start(form, {attr: {class: 'row g-3'}}) }}

    <div class="col-md-6">{{ form_row(form.company) }}</div>
    <div class="col-md-6">{{ form_row(form.type) }}</div>
    <div class="col-md-6">{{ form_row(form.planet) }}</div>
    <div class="col-md-6">{{ form_row(form.employer) }}</div>
    <div class="col-md-6">{{ form_row(form.employerAffiliation) }}</div>
    <div class="col-md-3">{{ form_row(form.scale) }}</div>
    <div class="col-md-3">{{ form_row(form.durationMonths) }}</div>
    <div class="col-md-3">{{ form_row(form.basePayPercent) }}</div>
    <div class="col-md-3">{{ form_row(form.numberOfTracks) }}</div>
    <div class="col-md-6">{{ form_row(form.intensity) }}</div>
    <div class="col-md-6">{{ form_row(form.commandRights) }}</div>
    <div class="col-md-6">{{ form_row(form.supportTerms) }}</div>
    <div class="col-md-6">{{ form_row(form.salvageRights) }}</div>
    <div class="col-md-6">{{ form_row(form.transportTerms) }}</div>

    <div class="col-12">
        <button class="btn btn-primary">Save Changes</button>
    </div>

    {{ form_end(form) }}
{% endblock %}
