{% extends 'base.html.twig' %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Contracts</h2>
    <a href="{{ path('app_contracts_generate') }}" class="btn btn-primary">Generate Contract</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Employer</th>
            <th>Scale</th>
            <th>Status</th>
            <th>Tracks</th>
            <th>Claimed By</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for c in contracts %}
    <tr>
        <td>{{ c.name }}</td>
        <td>{{ c.employer }}</td>
        <td>{{ c.scale }}</td>
        <td><span class="badge bg-{{ c.status.value == 'active' ? 'success' : 'secondary' }}">{{ c.status.value }}</span></td>
        <td>{{ c.tracksCompleted }}/{{ c.numberOfTracks }}</td>
        <td>{{ c.company ? c.company.name : '—' }}</td>
        <td>
            <a href="{{ path('app_contracts_show', {id: c.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
            {% if c.company == userCompany %}
            <form method="post" action="{{ path('app_contracts_delete', {id: c.id}) }}" class="d-inline"
                  onsubmit="return confirm('Delete this contract?')">
                <button class="btn btn-sm btn-danger">Del</button>
            </form>
            {% endif %}
        </td>
    </tr>
    {% else %}
    <tr><td colspan="7" class="text-muted">No contracts yet.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
