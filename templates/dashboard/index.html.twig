{% extends 'base.html.twig' %}
{% block body %}
<h2>{{ company.name }}</h2>
<div class="row g-3 mb-4">
<div class="col-6 col-md-3">
    <div class="card text-center">
    <div class="card-body py-3">
        <div class="fs-1 fw-bold">{{ company.reputation }}</div>
        <div class="text-muted small">Reputation</div>
    </div>
    </div>
</div>
<div class="col-6 col-md-3">
    <div class="card text-center">
    <div class="card-body py-3">
        <div class="fs-1 fw-bold">{{ spBalance }}</div>
        <div class="text-muted small">Support Points</div>
    </div>
    </div>
</div>
<div class="col-6 col-md-3">
    <div class="card text-center">
    <div class="card-body py-3">
        <div class="fs-1 fw-bold">{{ totalBv }}</div>
        <div class="text-muted small">Total BV</div>
    </div>
    </div>
</div>
<div class="col-6 col-md-3">
    <div class="card text-center">
    <div class="card-body py-3">
        <div class="fs-1 fw-bold">{{ namedPilots|length }}/4</div>
        <div class="text-muted small">Named Pilots</div>
    </div>
    </div>
</div>
</div>

{% if activeContracts is not empty %}
<h4>Active Contracts</h4>
{% for c in activeContracts %}
<div class="card mb-2">
<div class="card-body d-flex justify-content-between align-items-center">
    <div>
        <strong>{{ (c.type.value ?? c.name) | capitalize }}</strong> — {{ c.employer }}<br>
        <small class="text-muted">Tracks: {{ c.tracksCompleted }}/{{ c.numberOfTracks }}</small>
    </div>
    <a href="{{ path('app_contracts_show', {id: c.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
</div>
</div>
{% endfor %}

<br/>
    <h4>Companies support points:</h4>

{% for c in companiesAndSupportPoints %}
    <div class="card mb-2">
        <div class="card-body d-flex justify-content-between align-items-center">
            <strong>{{ c.company.name }}</strong>
            {{ c.supportPoints}}
        </div>
    </div>
{% endfor %}



{% else %}
<div class="alert alert-secondary">No active contracts. <a href="{{ path('app_contracts_generate') }}">Generate one.</a></div>
{% endif %}



{% endblock %}
