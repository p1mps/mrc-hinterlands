<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}MRC Hinterlands{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('css/battletech.css') }}">
</head>
<body>
{% if app.user %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_dashboard') }}">{{ app.user.getCompany().name }} - {{ app.user.getCompany().getSupportPointsBalance() }} SP</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('app_roster') }}">Roster</a>
                <a class="nav-link" href="{{ path('app_pilots') }}">Pilots</a>
                <a class="nav-link" href="{{ path('app_support_points') }}">Support Points</a>
                <a class="nav-link" href="{{ path('app_contracts') }}">Contracts</a>
                <a class="nav-link" href="{{ path('app_salvaged_mech_index') }}">Salvage</a>
                <a class="nav-link" href="{{ path('app_dropship_show') }}">Dropship</a>
                <a class="nav-link" href="{{ path('app_rules') }}">Rules</a>
                {% if app.user and 'ROLE_ALLOWED_TO_SWITCH' in app.user.getRoles() %}
                    {% set impersonatedUser = app.request.query.get('_switch_user') %}
                    {% if impersonatedUser and impersonatedUser != '_exit' %}
                        <span class="nav-link text-warning">Impersonating: {{ impersonatedUser }}</span>
                        <a class="nav-link" href="{{ path('app_dashboard') }}?_switch_user=_exit">Stop Impersonating</a>
                    {% else %}
                        <form action="{{ path('app_dashboard') }}" method="get" class="d-inline">
                            <input type="hidden" name="_switch_user" id="impersonateSelect" value="">
                            <select class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.querySelector('#impersonateSelect').value = this.value; this.form.submit()">
                                <option value="">Switch user...</option>
                                {% for user in users ?? [] %}
                                    <option value="{{ user.username }}" {% if user.username == app.user.username %}selected{% endif %}>{{ user.username }}</option>
                                {% endfor %}
                            </select>
                        </form>
                    {% endif %}
                {% endif %}
                <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
            </div>
        </div>
    </div>
</nav>
{% endif %}

<div class="container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'danger' ? 'danger' : 'info') }} alert-dismissible">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
