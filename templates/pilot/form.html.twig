{% extends 'base.html.twig' %}
{% block body %}
<div class="row justify-content-center">
<div class="col-md-6">
<h2>{{ title }}</h2>
<a href="{{ path('app_pilots') }}" class="btn btn-outline-secondary mb-3">Back to Pilots</a>
{{ form_start(form, {attr: {class: 'mb-3'}}) }}
    {{ form_row(form.name) }}
    {{ form_row(form.isNamed) }}
    {{ form_row(form.gunnery) }}
    {{ form_row(form.piloting) }}
    {{ form_row(form.gunneryXp) }}
    {{ form_row(form.pilotingXp) }}
    {{ form_row(form.wounded) }}
    {{ form_row(form.edgeTokens) }}
    {{ form_row(form.special_abilities) }}
    <div class="d-flex gap-2">
        <button class="btn btn-primary">Save</button>
    </div>
{{ form_end(form) }}
</div>
</div>
{% endblock %}
