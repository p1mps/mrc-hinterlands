{% extends 'base.html.twig' %}
{% block body %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h2>Pilots</h2>
    <a href="{{ path('app_pilots_new') }}" class="btn btn-primary align-self-start align-self-sm-auto">Add Pilot</a>
</div>
<div class="table-responsive">
<table class="table table-striped align-middle">
<thead><tr><th>Name</th><th>Named</th><th>Gunnery</th><th>Piloting</th><th>Gunnery XP</th><th>Piloting XP</th><th>Edge Tokens</th><th>Wounded</th><th>Unit</th><th></th></tr></thead>
<tbody>
{% for pilot in pilots %}
<tr class="{{ thresholdAlerts[pilot.id] is defined ? 'table-warning' : '' }}">
    <td>{{ pilot.name }}</td>
    <td>{{ pilot.isNamed ? 'Yes' : 'No' }}</td>
    <td>{{ pilot.gunnery }}</td>
    <td>{{ pilot.piloting }}</td>
    <td>{{ pilot.gunneryXp }}{% if thresholdAlerts[pilot.id] is defined %} <span class="badge bg-warning text-dark">{{ thresholdAlerts[pilot.id] }}</span>{% endif %}</td>
    <td>{{ pilot.pilotingXp }}</td>
    <td>{{ pilot.edgeTokens }}</td>
    <td>{{ pilot.wounded ? '<span class="badge bg-danger">Yes</span>' : '<span class="badge bg-secondary">No</span>'|raw }}</td>
    <td>{{ pilot.unit ? pilot.unit.name : '—' }}</td>
    <td class="text-nowrap">
        <a href="{{ path('app_pilots_edit', {id: pilot.id}) }}" class="btn btn-sm btn-secondary">Edit</a>
        {% if pilot.wounded %}
        <form method="post" action="{{ path('app_pilots_heal', {id: pilot.id}) }}" class="d-inline">
            <button class="btn btn-sm btn-success">Heal</button>
        </form>
        {% endif %}
        <form method="post" action="{{ path('app_pilots_delete', {id: pilot.id}) }}" class="d-inline"
              onsubmit="return confirm('Delete this pilot?')">
            <button class="btn btn-sm btn-danger">Del</button>
        </form>
    </td>
</tr>
{% else %}
<tr><td colspan="10" class="text-muted">No pilots yet.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
