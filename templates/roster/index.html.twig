{% extends 'base.html.twig' %}
{% block body %}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h2>{{ company.name }} — Roster</h2>
    <a href="{{ path('app_roster_new') }}" class="btn btn-primary align-self-start align-self-sm-auto">Add Unit</a>
</div>
<p><strong>Total BV:</strong> {{ totalBv }}</p>
<div class="table-responsive">
<table class="table table-striped align-middle">
<thead>
<tr>
    <th>Name</th>
    <th>Chassis</th>
    <th>Tonnage</th>
    <th>BV</th>
    <th>Type</th>
    <th>Damage</th>
    <th>Tech Base</th>
    <th>Base Repair Cost</th>
    <th>Discounted Repair Cost</th>
    <th>Support Terms</th>
    <th>Pilot</th>
    <!-- Set the min-width here for the button column -->
    <th style="min-width: 250px;">Actions</th>
</tr>
<tbody>
{% for unit in units %}
<tr>
    <td>{{ unit.name }}</td>
    <td>{{ unit.chassis }}</td>
    <td>{{ unit.tonnage }}</td>
    <td>{{ unit.bv }}</td>
    <td>{{ unit.unitType.value }}</td>
    <td>{{ unit.damageState.value }}</td>
    <td>{{ unit.techBase ? unit.techBase.value : "-" }}</td>
    <td>{{ baseRepairCosts[unit.id] ?? "-" }}</td>
    <td>{{ repairCosts[unit.id] ?? "-" }}</td>
    <td>{{ supportTerms[unit.id] }}</td>
    <td>
        <form method="post" action="{{ path('app_roster_assign_pilot', {id: unit.id}) }}" class="d-flex gap-1">
            <select name="pilot_id" class="form-select form-select-sm">
                <option value="">— none —</option>
                {% for pilot in pilots %}
                    {% if pilot.unit is null or pilot.unit.id == unit.id %}
                        <option value="{{ pilot.id }}"
                            {{ unit.pilot and unit.pilot.id == pilot.id ? 'selected' : '' }}>
                            {{ pilot.name }} ({{ pilot.gunnery }}/{{ pilot.piloting }})
                        </option>
                    {% endif %}
                {% endfor %}
            </select>
            <button class="btn btn-sm btn-outline-secondary">Set</button>
        </form>
    </td>
    <td class="text-nowrap">
        <div class="d-flex gap-1 w-100">
            <a href="{{ path('app_roster_edit', {id: unit.id}) }}" class="btn btn-sm btn-secondary flex-fill text-center">Edit</a>

            {% if unit.damageState.value != 'none' %}
                <form method="post" action="{{ path('app_roster_repair', {id: unit.id}) }}"
                      onsubmit="return confirm('Repair this unit? This will deduct SP based on tonnage and damage state.');"
                      class="flex-fill">
                    <button class="btn btn-sm btn-info w-100">Repair</button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('app_roster_delete', {id: unit.id}) }}"
                  onsubmit="return confirm('Delete this unit?')"
                  class="flex-fill">
                <button class="btn btn-sm btn-danger w-100">Del</button>
            </form>

            <form method="post" action="{{ path('app_roster_battlefield_lose', {id: unit.id}) }}"
                  onsubmit="return confirm('Mark \'{{ unit.name }}\' as a battlefield loss? This will remove the unit and credit support points based on your active contract.');"
                  class="flex-fill">
                <button class="btn btn-sm btn-warning w-100">Battlefield Loss</button>
            </form>

            <form method="post" action="{{ path('app_roster_rearm', {id: unit.id}) }}"
                  onsubmit="return confirm('Rearm \'{{ unit.name }}\'? This will deduct SP % Support terms.');"
                  class="flex-fill">
                <button class="btn btn-sm btn-success w-100">Rearm</button>
            </form>
        </div>
    </td>

</tr>
{% else %}
<tr><td colspan="11" class="text-muted">No units yet.</td></tr>
{% endfor %}
</tbody>
</table>
</div>
{% endblock %}
