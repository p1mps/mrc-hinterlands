{% extends 'base.html.twig' %}
{% block body %}
<h2>{{ title }}</h2>
{{ form_start(form) }}
{{ form_row(form.name) }}
{{ form_row(form.chassis) }}
{{ form_row(form.tonnage) }}
{{ form_row(form.bv) }}
{{ form_row(form.unitType) }}
{{ form_row(form.damageState) }}
{{ form_row(form.isActive) }}
<button class="btn btn-primary">Save</button>
<a href="{{ path('app_roster') }}" class="btn btn-secondary">Cancel</a>
{{ form_end(form) }}
{% endblock %}
