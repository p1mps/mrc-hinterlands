{% extends 'base.html.twig' %}
{% block body %}
<div class="row justify-content-center">
<div class="col-md-6">
<h2>{{ title }}</h2>
<a href="{{ path('app_roster') }}" class="btn btn-outline-secondary mb-3">Back to Roster</a>
{{ form_start(form, {attr: {class: 'mb-3'}}) }}
    {{ form_row(form.name) }}
    {{ form_row(form.chassis) }}
    {{ form_row(form.tonnage) }}
    {{ form_row(form.bv) }}
    {{ form_row(form.unitType) }}
    {{ form_row(form.damageState) }}
    {{ form_row(form.techBase) }}
    <div class="d-flex gap-2">
        <button class="btn btn-primary">Save</button>
    </div>
{{ form_end(form) }}
</div>
</div>
{% endblock %}
